HTTP_ADDR=:8080
MYSQL_DSN='likeflow:likeflow@tcp(127.0.0.1:3306)/likeflow?parseTime=true&charset=utf8mb4'
REDIS_ADDR=127.0.0.1:6379
MQ_NAMESERVER=127.0.0.1:9876
MQ_TOPIC=like-events
# Replace before running; shell environment variables are read directly (no dotenv loader).
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
DEMO_MODE=true
MAX_BACKLOG=10000
